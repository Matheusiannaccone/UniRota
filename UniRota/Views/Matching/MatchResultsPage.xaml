<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="UniRota.Views.Matching.MatchResultsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UniRota.ViewModels"
    Shell.NavBarIsVisible="True" Title="Motoristas disponíveis">
    <Grid Style="{StaticResource ListLayout}" RowDefinitions="Auto,Auto,Auto,*">
        <Border Style="{StaticResource InfoCard}">
            <VerticalStackLayout Style="{StaticResource DetailContent}">
                <Label Text="Sua rota" Style="{StaticResource CardTitle}" />
                <Label Text="{Binding PassengerRouteText}" />
                <Label Text="{Binding PassengerRouteDetailsText}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </Border>
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <VerticalStackLayout Grid.Row="2" Style="{StaticResource DetailContent}" IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" />
            <Button Text="Tentar novamente" Command="{Binding LoadCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
        <Grid Grid.Row="3">
            <Label Text="Nenhuma rota compatível foi encontrada." IsVisible="{Binding ShowEmptyState}" Style="{StaticResource EmptyState}" />
            <CollectionView ItemsSource="{Binding Results}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:MatchResultItemViewModel">
                        <Border Style="{StaticResource ListCard}">
                            <VerticalStackLayout Style="{StaticResource SectionContent}">
                                <Label Text="{Binding DriverNameText}" Style="{StaticResource SectionTitle}" />
                                <Label Text="Trajeto compatível" Style="{StaticResource SuccessBadge}" />
                                <Label Text="{Binding OriginDestinationText}" Style="{StaticResource CardTitle}" />
                                <VerticalStackLayout Style="{StaticResource DetailContent}">
                                    <Label Text="{Binding CompatibleDaysText, StringFormat='Dias compatíveis: {0}'}" Style="{StaticResource PageSubtitle}" />
                                    <Label Text="{Binding DepartureTimeText, StringFormat='Saída às {0}'}" />
                                    <Label Text="{Binding AvailableSeatsText}" Style="{StaticResource SuccessBadge}" />
                                    <Label Text="{Binding DetourText}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Button Text="Solicitar" Clicked="OnRequestRideClicked" CommandParameter="{Binding .}" Style="{StaticResource PrimaryButton}" />
                                <Button Text="Ver trajeto no mapa" Clicked="OnViewRouteClicked" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
