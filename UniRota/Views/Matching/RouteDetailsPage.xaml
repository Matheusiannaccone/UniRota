<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="UniRota.Views.Matching.RouteDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
    Shell.NavBarIsVisible="True" Title="Detalhes do trajeto">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <VerticalStackLayout Style="{StaticResource DetailContent}">
                <Label Text="Trajeto compartilhado" Style="{StaticResource PageTitle}" />
                <Label Text="{Binding DriverRouteText}" Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid HeightRequest="360">
                    <maps:Map x:Name="RouteMap" IsShowingUser="False" IsVisible="{Binding HasMapData}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Text="Não foi possível exibir o trajeto no mapa." IsVisible="{Binding ShowMapPlaceholder}" Style="{StaticResource EmptyState}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource InfoCard}">
                <VerticalStackLayout Style="{StaticResource SectionContent}">
                    <Label Text="Seu trajeto em números" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding DistanceText}" Style="{StaticResource CardTitle}" />
                    <Label Text="{Binding DurationText}" Style="{StaticResource CardTitle}" />
                    <Label Text="{Binding DetourText}" Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding MapMessage}" IsVisible="{Binding HasMapMessage}" Style="{StaticResource Caption}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
