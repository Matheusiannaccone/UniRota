<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="UniRota.Views.Auth.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False" Title="Criar conta">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource AuthContent}">
            <!-- Container substituível pela marca oficial. -->
            <Grid Style="{StaticResource BrandSlot}" ColumnDefinitions="Auto,*">
                <Button Text="‹" Command="{Binding GoToLoginCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource LinkButton}" SemanticProperties.Description="Voltar para login" />
                <Label Grid.Column="1" Text="UniRota" Style="{StaticResource BrandText}" />
            </Grid>
            <VerticalStackLayout Style="{StaticResource DetailContent}">
                <Label Text="Criar conta" Style="{StaticResource PageTitle}" />
                <Label Text="Faça parte do UniRota e organize seus deslocamentos à Facens." Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>
            <VerticalStackLayout Style="{StaticResource SectionContent}">
                <Border Style="{StaticResource InputContainer}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Nome completo" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding Name}" Placeholder="Seu nome" ReturnType="Next" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>
                <Border Style="{StaticResource InputContainer}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="E-mail" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding Email}" Placeholder="seu@email.com" Keyboard="Email" ReturnType="Next" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>
                <Border Style="{StaticResource InputContainer}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Senha" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding Password}" Placeholder="Mínimo de 6 caracteres" IsPassword="True" ReturnType="Next" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>
                <Border Style="{StaticResource InputContainer}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Confirmar senha" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding ConfirmPassword}" Placeholder="Digite a senha novamente" IsPassword="True" ReturnType="Go" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>
            </VerticalStackLayout>
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorMessage}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Criar conta" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Já tenho uma conta" Command="{Binding GoToLoginCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource LinkButton}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
