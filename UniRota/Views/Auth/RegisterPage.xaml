<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="UniRota.Views.Auth.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Title="Criar conta">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="{AppThemeBinding Light=#F4FAFF, Dark=#0D1D29}" />
            <GradientStop Offset="0.55" Color="{AppThemeBinding Light=#FFFFFF, Dark=#101E29}" />
            <GradientStop Offset="1" Color="{AppThemeBinding Light=#F2FBFC, Dark=#102630}" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <Border WidthRequest="210" HeightRequest="210" TranslationX="100" TranslationY="-125"
                HorizontalOptions="End" VerticalOptions="Start" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#DDF3FF, Dark=#12364E}" Opacity="0.48"
                StrokeShape="RoundRectangle 105" InputTransparent="True" />

        <ScrollView>
            <VerticalStackLayout Style="{StaticResource AuthRedesignContent}" Spacing="22">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <ImageButton Source="auth_back.svg" Command="{Binding GoToLoginCommand}"
                                 IsEnabled="{Binding IsNotBusy}" Style="{StaticResource AuthBackButton}"
                                 SemanticProperties.Description="Voltar para o login" />
                    <VerticalStackLayout Grid.Column="1" Spacing="-2" VerticalOptions="Center">
                        <Label Text="UniRota" Style="{StaticResource AuthBrandName}" FontSize="20" />
                        <Label Text="Sua comunidade de caronas" Style="{StaticResource AuthTagline}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Style="{StaticResource AuthBrandMark}" WidthRequest="46" HeightRequest="46" Padding="9">
                        <Image Source="auth_route.svg" SemanticProperties.Description="Símbolo de rota" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="9" Margin="0,6,0,2">
                    <Label Text="COMECE POR AQUI" Style="{StaticResource AuthEyebrow}" />
                    <Label Text="Crie sua conta e venha junto." Style="{StaticResource AuthTitle}" />
                    <Label Text="Seu próximo trajeto pode começar com alguém da mesma comunidade." Style="{StaticResource AuthSubtitle}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource AuthHeroSurface}" HeightRequest="142">
                    <Image Source="auth_hero.png" Aspect="AspectFit"
                           Margin="8,-5,8,-2"
                           SemanticProperties.Description="Estudantes compartilhando uma rota de carro até o campus" />
                </Border>

                <VerticalStackLayout Spacing="15">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="Nome completo" Style="{StaticResource AuthFieldLabel}" />
                        <Border Style="{StaticResource AuthInputContainer}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Style="{StaticResource AuthFieldIconSurface}">
                                    <Image Source="auth_user.svg" SemanticProperties.Description="Nome" />
                                </Border>
                                <Entry Grid.Column="1" Text="{Binding Name}" Placeholder="Como podemos chamar você?"
                                       ReturnType="Next" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource AuthEntry}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">
                        <Label Text="E-mail" Style="{StaticResource AuthFieldLabel}" />
                        <Border Style="{StaticResource AuthInputContainer}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Style="{StaticResource AuthFieldIconSurface}">
                                    <Image Source="auth_mail.svg" SemanticProperties.Description="E-mail" />
                                </Border>
                                <Entry Grid.Column="1" Text="{Binding Email}" Placeholder="seu@email.com"
                                       Keyboard="Email" ReturnType="Next" IsEnabled="{Binding IsNotBusy}"
                                       Style="{StaticResource AuthEntry}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">
                        <Label Text="Senha" Style="{StaticResource AuthFieldLabel}" />
                        <Border Style="{StaticResource AuthInputContainer}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Style="{StaticResource AuthFieldIconSurface}">
                                    <Image Source="auth_lock.svg" SemanticProperties.Description="Senha" />
                                </Border>
                                <Entry Grid.Column="1" Text="{Binding Password}" Placeholder="Mínimo de 6 caracteres"
                                       IsPassword="True" ReturnType="Next" IsEnabled="{Binding IsNotBusy}"
                                       Style="{StaticResource AuthEntry}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">
                        <Label Text="Confirmar senha" Style="{StaticResource AuthFieldLabel}" />
                        <Border Style="{StaticResource AuthInputContainer}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Style="{StaticResource AuthFieldIconSurface}">
                                    <Image Source="auth_lock.svg" SemanticProperties.Description="Confirmar senha" />
                                </Border>
                                <Entry Grid.Column="1" Text="{Binding ConfirmPassword}" Placeholder="Digite a senha novamente"
                                       IsPassword="True" ReturnType="Go" IsEnabled="{Binding IsNotBusy}"
                                       Style="{StaticResource AuthEntry}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorMessage}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                <Button Text="Criar minha conta  →" Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding IsNotBusy}" Style="{StaticResource AuthPrimaryButton}" />
                <Button Text="Já tenho uma conta" Command="{Binding GoToLoginCommand}"
                        IsEnabled="{Binding IsNotBusy}" Style="{StaticResource AuthSecondaryButton}" />

                <Border Style="{StaticResource AuthInfoCard}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                        <Border Style="{StaticResource AuthFieldIconSurface}" WidthRequest="44" HeightRequest="44" Padding="9">
                            <Image Source="auth_people.svg" SemanticProperties.Description="Comunidade" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Um espaço feito para conexões reais" Style="{StaticResource AuthFieldLabel}" FontSize="14" />
                            <Label Text="Seus dados são usados para criar e acessar sua conta com segurança." Style="{StaticResource AuthSubtitle}" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
