<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="UniRota.Views.Auth.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False" Title="Entrar">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource AuthContent}">
            <!-- Container substituível pela marca oficial. -->
            <Grid Style="{StaticResource BrandSlot}" ColumnDefinitions="Auto,*">

                <Label Grid.Column="1" Text="UniRota" Style="{StaticResource BrandText}" />
            </Grid>
            <VerticalStackLayout Style="{StaticResource DetailContent}">
                <Label Text="Bem-vindo" Style="{StaticResource PageTitle}" />
                <Label Text="Acesse sua conta para continuar sua jornada na Facens." Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>
            <VerticalStackLayout Style="{StaticResource SectionContent}">

                <Border Style="{StaticResource InputContainer}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="E-mail" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding Email}" Placeholder="seu@email.com" Keyboard="Email" ReturnType="Next" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>
                <Border Style="{StaticResource InputContainer}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Senha" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding Password}" Placeholder="Digite sua senha" IsPassword="True" ReturnType="Go" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            </VerticalStackLayout>
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorMessage}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Entrar →" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Ainda não tenho conta? Criar conta" Command="{Binding GoToRegisterCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource LinkButton}" />
            <Border Style="{StaticResource InfoCard}">
                <VerticalStackLayout Style="{StaticResource DetailContent}">
                    <Label Text="Na mesma direção" Style="{StaticResource CardTitle}" />
                    <Label Text="Conectando você a uma vida acadêmica mais prática e organizada." Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
