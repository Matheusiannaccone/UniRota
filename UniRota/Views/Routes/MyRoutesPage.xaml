<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UniRota.Views.Routes.MyRoutesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UniRota.ViewModels"
    Shell.NavBarIsVisible="True"
    Title="Minhas rotas">

    <Grid
        Padding="20,24,20,20"
        MaximumWidthRequest="640"
        HorizontalOptions="Fill"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="16">

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
            <Label
                Grid.Column="0"
                Text="Minhas rotas"
                FontSize="28"
                FontAttributes="Bold"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Text="Nova rota"
                Clicked="OnNewRouteClicked"
                IsEnabled="{Binding IsNotBusy}" />
        </Grid>

        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center" />

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="8"
            IsVisible="{Binding HasError}">
            <Label
                Text="{Binding ErrorMessage}"
                TextColor="#B3261E"
                HorizontalTextAlignment="Center" />
            <Button
                Text="Tentar novamente"
                Command="{Binding LoadCommand}"
                IsEnabled="{Binding IsNotBusy}"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <Grid Grid.Row="3">
            <Label
                Text="Você ainda não cadastrou nenhuma rota semanal."
                IsVisible="{Binding ShowEmptyState}"
                TextColor="#616161"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center" />

            <CollectionView
                ItemsSource="{Binding Routes}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:WeeklyRouteItemViewModel">
                        <Border
                            Margin="0,0,0,12"
                            Padding="16"
                            Stroke="#E0E0E0"
                            BackgroundColor="#FAFAFA">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Text="{Binding RoleText}"
                                    FontSize="18"
                                    FontAttributes="Bold" />
                                <Label
                                    Text="{Binding OriginDestinationText}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    LineBreakMode="WordWrap" />
                                <Label
                                    Text="{Binding DaysText}"
                                    TextColor="#616161"
                                    LineBreakMode="WordWrap" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding DepartureTimeText, StringFormat='Horário: {0}'}" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding AvailableSeatsText}"
                                        IsVisible="{Binding HasAvailableSeats}"
                                        HorizontalOptions="End" />
                                </Grid>
                                <Label
                                    Text="{Binding EstimatedDistanceText}"
                                    IsVisible="{Binding HasEstimatedDistance}"
                                    TextColor="#616161" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button
                                        Grid.Column="0"
                                        Text="Editar"
                                        Clicked="OnEditRouteClicked"
                                        CommandParameter="{Binding .}" />
                                    <Button
                                        Grid.Column="1"
                                        Text="Excluir"
                                        Clicked="OnDeleteRouteClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#B3261E" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
